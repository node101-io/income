extends ../partials/head
block content
  .all-wrapper
    input.display-none#wallet-json(type='text' value=JSON.stringify(wallet))
    .form-wrapper
      h1.general-text-title Edit Wallet - #{wallet.name}
      input.general-form-input#wallet-name(type='text' name='Name' placeholder='Wallet Name' value=wallet.name required)
      input.general-form-input#wallet-type(type='text' name='Type' placeholder='Wallet Type' value=wallet.type required)
      input.general-form-input#wallet-reward-comission(type='text' name='Reward Comission' placeholder='Reward Comission' value=wallet.reward_comission required)
      .general-form-button-wrapper
        a.general-form-button(href='/') Back
        button.general-form-button#wallet-update-button(style='margin-left: auto; color: var(--second-color)') Edit
        a.general-form-button(href='/chain/wallet/edit/delete?id=' + wallet._id onclick='return confirm("Are you sure you want to delete this chain?")' style='margin-top: 40px; color: var(--warning-color)') Delete