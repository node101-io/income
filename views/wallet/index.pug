extends ../partials/head
block content
  .all-wrapper
    .all-header
      input.display-none#chain-json(type='text' value=JSON.stringify(chain))
      h1.general-text-title= chain.identifier + ' - Wallet List'
      input.general-form-input#wallet-name(type='text' placeholder='Search' value=chains_search style='margin-left: auto; margin-right: 20px;')
      a.general-form-button(href='/chain/wallet/create?chain_id=' + chain._id) Add New Wallet
    .all-content
      each wallet in wallets
        .each-wallet-wrapper
          h2.general-text-subtitle= wallet.name
          span.general-text-text= chain.available_balance
          a.general-form-button(href='/chain/wallet/edit?id=' + wallet._id style='margin-left: auto;') Edit

