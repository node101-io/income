extends ../partials/head
block content
  .all-wrapper
    input.display-none#chain-json(type='text' value=JSON.stringify(chain))
    .form-wrapper
      h1.general-text-title Edit Chain - #{chain.identifier}
      input.general-form-input#chain-apr-input(type='text' name='Chain APR' placeholder='Chain APR' value=chain.apr required)
      input.general-form-input#chain-token(type='text' name='Token' placeholder='Token' value=chain.token required)
      .general-form-button-wrapper
        a.general-form-button(href='/') Back
        button.general-form-button#chain-update-button(style='color: var(--second-color)') Edit
        a.general-form-button(href='update/delete?chain_id=' + chain._id onclick='return confirm("Are you sure you want to delete this chain?")' style='margin-top: 40px; color: var(--warning-color)') Delete