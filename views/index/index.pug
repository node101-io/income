extends ../partials/head
block content
  .all-wrapper
    .all-header
      h1.general-text-title Chain List
      input.general-form-input#chain-search-input(type='text' placeholder='Search' value=chains_search style='margin-left: auto; margin-right: 20px;')
      a.general-form-button(href='/chain/create') Add New Chain
    .all-content
      if chains_search
        span.general-page-search-text
        //#{__('Showing results of the search:')} "#{chains_search}"
      .general-page-inner-wrapper
        .general-page-buttons-wrapper
          if chains_page > 0
            a.general-page-prev-button(href=`/admin?page=${chains_page-1}${chains_search ? '&search=' + chains_search : ''}`) <
            //#{__('Previous')}
          else
            span.general-page-prev-button.general-page-prev-button-not-allowed <
            //#{__('Previous')}
          - for (let i = 0; i < parseInt(chains_count / chains_limit) + (chains_count % chains_limit ? 1 : 0); i += 1)
            if i != chains_page
              a.general-each-page-button(href=`/admin?page=${i}${chains_search ? '&search=' + chains_search : ''}`)= i+1
            else
              span.general-each-page-button.general-each-page-button-selected= i+1
          if (chains_page + 1) * chains_limit < chains_count
            a.general-page-next-button(href=`/admin?page=${chains_page+1}${chains_search ? '&search=' + chains_search : ''}`)
            //#{__('Next')} >
          else
            span.general-page-next-button.general-page-next-button-not-allowed
            //#{__('Next')} >
          span.general-page-info
          //#{__('Showing')} #{chains_limit} #{__('results per page.')}
      each chain in chains
        .each-chain-wrapper
          h2.general-text-subtitle= chain.identifier
          span.general-text-text= chain.apr
          a.general-form-button(href='/chain/update?id=' + chain._id style='margin-left: auto;') Update
          a.general-form-button(href='/chain/wallet?chain_id=' + chain._id style='margin-left: 20px;') Wallets