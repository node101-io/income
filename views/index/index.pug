extends ../partials/head
block content
  .all-wrapper
    .all-header
      h1.general-text-title Chain List
      input.general-form-input#chain-token(type='text' placeholder='Search' value=chains_search style='margin-left: auto; margin-right: 20px;')
      a.general-form-button(href='/chain/create') Add New Chain
    .all-content
      each chain in chains
        .each-chain-wrapper
          h2.general-text-subtitle= chain.identifier
          span.general-text-text= chain.apr
          a.general-form-button(href='/chain/update?id=' + chain._id style='margin-left: auto;') Update
          a.general-form-button(href='/chain/wallet?chain_id=' + chain._id ) Wallets